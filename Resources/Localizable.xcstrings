    "paneMemoryGuardrail.confirm.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This sends SIGTERM then SIGKILL to high-memory process groups in the pane. Other process groups are left alone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペイン内の高メモリ使用プロセスグループに SIGTERM、続いて SIGKILL を送信します。他のプロセスグループには影響しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会向该窗格中占用高内存的进程组先发送 SIGTERM 再发送 SIGKILL。其他进程组不受影响。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies sendet SIGTERM und anschließend SIGKILL an Prozessgruppen mit hohem Speicherverbrauch im Teilfenster. Andere Prozessgruppen bleiben unberührt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela envoie SIGTERM puis SIGKILL aux groupes de processus gourmands en mémoire dans le volet. Les autres groupes de processus sont laissés tranquilles."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرسل هذا إشارتي SIGTERM ثم SIGKILL إلى مجموعات العمليات التي تستهلك ذاكرة عالية في الجزء. ولن تتأثر مجموعات العمليات الأخرى."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto envía SIGTERM y luego SIGKILL a los grupos de procesos con alto consumo de memoria en el panel. Los otros grupos de procesos no se verán afectados."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會向窗格中高記憶體使用量的程序群組傳送 SIGTERM，然後傳送 SIGKILL。其他程序群組將不受影響。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 동작은 분할 창의 고메모리 프로세스 그룹에 SIGTERM을 보낸 다음 SIGKILL을 보냅니다. 다른 프로세스 그룹은 유지됩니다."
          }
        }
      }
    },
