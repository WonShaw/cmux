          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم %@ وصولاً للبيانات الوصفية فقط حتى تمنحه حق الوصول إلى البيانات والإجراءات المطلوبة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está usando acceso solo a metadatos hasta que concedas los datos y acciones solicitados."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在您授予其請求的資料與動作前，將僅能存取中介資料。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청된 데이터 및 작업 권한을 허용할 때까지 %@은(는) 메타데이터 전용 액세스를 사용합니다."
