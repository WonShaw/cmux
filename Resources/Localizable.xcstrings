        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "restore：已保存的工作目录无法访问。请恢复其访问权限，然后重试。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "restore: Auf das gespeicherte Arbeitsverzeichnis kann nicht zugegriffen werden. Stellen Sie den Zugriff darauf wieder her und versuchen Sie es dann erneut."
