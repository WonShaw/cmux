      }
    },
    "sudo.approval.warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review the entire script before approving. It will run with administrator privileges."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "承認する前にスクリプト全体を確認してください。管理者権限で実行されます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überprüfen Sie das gesamte Skript, bevor Sie es genehmigen. Es wird mit Administratorrechten ausgeführt."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بمراجعة النص بأكمله قبل الموافقة عليه. سيتم تشغيله بامتيازات المسؤول."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregledajte cijelu skriptu prije odobravanja. Pokrenut će se s administratorskim privilegijama."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gennemgå hele scriptet, før du godkender det. Det vil køre med administratorrettigheder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revise el guión completo antes de aprobarlo. Se ejecutará con privilegios de administrador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez en revue l’intégralité du script avant de l’approuver. Il fonctionnera avec les privilèges d'administrateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esamina l'intero script prima di approvarlo. Verrà eseguito con privilegi di amministratore."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ពិនិត្យមើលស្គ្រីបទាំងមូលមុនពេលអនុម័ត។ វានឹងដំណើរការជាមួយនឹងសិទ្ធិជាអ្នកគ្រប់គ្រង។"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se gjennom hele manuset før du godkjenner det. Det vil kjøre med administratorrettigheter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przed zatwierdzeniem przejrzyj cały skrypt. Będzie działać z uprawnieniami administratora."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revise o script inteiro antes de aprovar. Ele será executado com privilégios de administrador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прежде чем утверждать, просмотрите весь сценарий. Он будет работать с правами администратора."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจสอบสคริปต์ทั้งหมดก่อนที่จะอนุมัติ มันจะทำงานด้วยสิทธิ์ของผู้ดูแลระบบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onaylamadan önce betiğin tamamını inceleyin. Yönetici ayrıcalıklarıyla çalışacaktır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перегляньте весь сценарій перед схваленням. Він працюватиме з правами адміністратора."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在批准之前检查整个脚本。它将以管理员权限运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在批准之前檢查整個腳本。它將以管理員權限運行。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "승인하기 전에 전체 스크립트를 검토하세요. 관리자 권한으로 실행됩니다."
          }
        }
      }
    },
