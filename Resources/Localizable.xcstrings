    "settings.browser.chromiumExtensions.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unpacked extension directories loaded into Chromium browser panes. One absolute path per line; each directory must contain a manifest.json. Applies when the next pane starts."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chromium ブラウザペインに読み込むパッケージ化されていない拡張機能のディレクトリ。1 行につき絶対パス 1 件で、各ディレクトリに manifest.json が必要です。次のペイン起動時に適用されます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entpackte Erweiterungsverzeichnisse, die in Chromium-Browser-Bereiche geladen werden. Ein absoluter Pfad pro Zeile; jedes Verzeichnis muss eine manifest.json enthalten. Wird angewendet, wenn der nächste Bereich startet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répertoires d'extensions non empaquetées chargés dans les volets de navigateur Chromium. Un chemin absolu par ligne ; chaque répertoire doit contenir un fichier manifest.json. S'applique au démarrage du prochain volet."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدلة الامتدادات غير المضغوطة المحملة في أجزاء متصفح Chromium. مسار مطلق واحد في كل سطر؛ يجب أن يحتوي كل دليل على ملف manifest.json. ينطبق عند بدء تشغيل الجزء التالي."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Directorios de extensiones descomprimidos cargados en paneles del navegador Chromium. Una ruta absoluta por línea; cada directorio debe contener un manifest.json. Se aplica cuando se inicia el siguiente panel."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "載入至 Chromium 瀏覽器窗格的未封裝擴充功能目錄。每行一個絕對路徑；每個目錄都必須包含 manifest.json。於下一個窗格啟動時套用。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加载到 Chromium 浏览器窗格中的未打包扩展目录。每行一个绝对路径；每个目录必须包含一个 manifest.json。在下一个窗格启动时生效。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chromium 브라우저 패인에 로드할 패키지되지 않은 확장 프로그램 디렉터리입니다. 한 줄에 하나의 절대 경로를 작성해야 하며, 각 디렉터리에는 manifest.json 파일이 포함되어 있어야 합니다. 다음 패인이 시작될 때 적용됩니다."
          }
        }
      }
    },
