          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--clear                Ryd meddelelser for det fundne mål i stedet for at sende"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--clear                Benachrichtigungen des aufgelösten Ziels löschen statt senden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--clear                Limpia las notificaciones del destino resuelto en vez de publicar"
