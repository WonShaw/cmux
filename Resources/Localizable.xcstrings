    "cloudTree.tunnel.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The cmux Cloud Tunnel is a macOS network extension that gives every app on this Mac a route to your Cloud VM network. cmux itself does not need it: terminals, Ports, and Desktop use the built-in user-space tunnel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux クラウドトンネルは、この Mac のすべてのアプリにクラウド VM ネットワークへの経路を与える macOS のネットワーク機能拡張です。cmux 自体には不要です。ターミナル、ポート、デスクトップは内蔵のユーザー空間トンネルを使います。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der cmux Cloud Tunnel ist eine macOS-Netzwerk-Extension, die jeder App auf diesem Mac eine Route zu Ihrem Cloud-VM-Netzwerk zuweist. cmux selbst benötigt diese nicht: Terminals, Ports und Desktop nutzen den integrierten User-Space-Tunnel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Tunnel Cloud cmux est une extension réseau macOS qui donne à chaque application sur ce Mac un accès à votre réseau de VM Cloud. cmux lui-même n'en a pas besoin : les terminaux, Ports et Desktop utilisent le tunnel en espace utilisateur intégré."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نفق cmux Cloud Tunnel هو امتداد شبكة لنظام التشغيل macOS يمنح كل تطبيق على جهاز Mac هذا مسارًا إلى شبكة أجهزة Cloud VM الخاصة بك. لا يحتاج cmux نفسه إليه: تستخدم محطات الطرفية والمنافذ وسطح المكتب النفق المدمج في مساحة المستخدم."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Túnel en la nube de cmux es una extensión de red de macOS que otorga a cada aplicación en esta Mac una ruta hacia su red de VM en la nube. cmux mismo no la necesita: las terminales, Puertos y Escritorio utilizan el túnel integrado en espacio de usuario."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux Cloud Tunnel 是一個 macOS 網路延伸功能，可為這台 Mac 上的每個應用程式提供通往您的 Cloud VM 網路的路由。cmux 本身不需要它：終端機、Ports 和 Desktop 使用內建的使用者空間通道。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux 云隧道是一个 macOS 网络扩展，它让此 Mac 上的每个应用都有一条通往您的云 VM 网络的路由。cmux 本身不需要它：终端、端口和桌面使用内置的用户空间隧道。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux Cloud Tunnel은 이 Mac의 모든 앱에 Cloud VM 네트워크로 가는 경로를 제공하는 macOS 네트워크 확장 프로그램입니다. cmux 자체는 이것이 필요하지 않습니다: 터미널, Ports, Desktop은 내장된 사용자 공간 터널을 사용합니다."
          }
        }
      }
    },
    "agentRestore.admission.invalid" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent restore admission requires a valid workspace, surface, kind, and session."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントの復元許可には、有効なワークスペース、サーフェス、種類、セッションが必要です。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zulassung zur Agent-Wiederherstellung erfordert einen gültigen Arbeitsbereich, eine gültige Oberfläche, einen gültigen Typ und eine gültige Sitzung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’admission de restauration de l’agent requiert un espace de travail, une surface d’affichage, un type et une session valides."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب قبول استعادة الوكيل مساحة عمل، وسطح، ونوع، وجلسة صالحة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La admisión de restauración del agente requiere un espacio de trabajo, superficie, tipo y sesión válidos."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代理程式還原准入需要有效的工作區、介面、種類及工作階段。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复智能体准入需要有效的工作区、表面、类型和会话。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트 복구 승인에는 유효한 작업 공간, 화면, 종류 및 세션이 필요합니다."
          }
        }
      }
    },
    "agentRestore.admission.releaseInvalid" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent restore claim release requires a valid kind, session, and claim identifier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントの復元要求を解放するには、有効な種類、セッション、要求 ID が必要です。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Freigabe der Agent-Wiederherstellungsanforderung erfordert einen gültigen Typ, eine gültige Sitzung und eine gültige Anforderungskennung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La libération de la revendication de restauration de l’agent requiert un type, une session et un identifiant de revendication valides."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب تحرير مطالبة استعادة الوكيل نوع، وجلسة، ومعرف مطالبة صالح."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La liberación de reclamación de restauración del agente requiere un tipo, sesión e identificador de reclamación válidos."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代理程式還原宣告釋放需要有效的種類、工作階段及宣告識別碼。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "释放智能体恢复所有权需要有效的类型、会话和所有权标识符。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트 복구 클레임 해제에는 유효한 종류, 세션 및 클레임 식별자가 필요합니다."
          }
        }
      }
    },
    "agentRestore.admission.targetChanged" : {
