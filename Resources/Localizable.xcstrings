    "socket.terminal.inputQueueFull" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The terminal can't accept more input right now. Wait a moment and retry, or reopen the terminal if it stays unavailable."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルは現在これ以上の入力を受け付けられません。しばらくしてから再試行するか、利用できない状態が続く場合はターミナルを開き直してください。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Terminal kann derzeit keine weiteren Eingaben akzeptieren. Warten Sie einen Moment und versuchen Sie es erneut, oder öffnen Sie das Terminal erneut, wenn es weiterhin nicht verfügbar ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le terminal ne peut pas accepter plus d'entrées pour le moment. Attendez un moment et réessayez, ou rouvrez le terminal s'il reste indisponible."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن للمحطة قبول المزيد من المدخلات في الوقت الحالي. انتظر لحظة وأعد المحاولة، أو أعد فتح الجهاز إذا ظل غير متاح."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El terminal no puede aceptar más entradas en este momento. Espere un momento y vuelva a intentarlo, o vuelva a abrir la terminal si no está disponible."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终端现在无法接受更多输入。稍等片刻然後重試，或者如果終端仍然不可用，請重新打開終端。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终端目前无法接受更多输入。请稍候重试；若持续不可用，请重新打开终端。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 터미널은 더 많은 입력을 받아들일 수 없습니다. 잠시 기다렸다가 다시 시도하거나 계속 사용할 수 없는 경우 터미널을 다시 여세요."
          }
        }
      }
    },
    "socket.terminal.processExited" : {
