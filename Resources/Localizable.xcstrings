        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팔레트 항목이 없습니다. cmux.json에서 색상을 추가하거나 워크스페이스 컨텍스트 메뉴의 \"사용자 지정 색상 선택...\"을 사용하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有调色板条目。请在 cmux.json 中添加颜色，或在工作区右键菜单中使用「选取自定义颜色...」。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Paletteneinträge. Fügen Sie Farben in cmux.json hinzu oder verwenden Sie \"Benutzerdefinierte Farbe wählen...\" aus dem Kontextmenü eines Arbeitsbereichs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune entrée dans la palette. Ajoutez des couleurs dans cmux.json ou utilisez \"Choisir une couleur personnalisée...\" depuis un menu contextuel d'espace de travail."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد عناصر في لوحة الألوان. أضف ألوانًا في cmux.json أو استخدم \"Choose Custom Color...\" من القائمة السياقية لمساحة العمل."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin entradas de paleta. Añade colores en cmux.json o usa \"Choose Custom Color...\" desde el menú contextual de un espacio de trabajo."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
