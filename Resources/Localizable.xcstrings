          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux no pudo crear el directorio de hooks: ya existe un archivo en %@. Elimina o cambia el nombre del archivo en conflicto y vuelve a ejecutar `cmux hooks setup`."
