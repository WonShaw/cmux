    "settings.app.defaultTerminal.dialog.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux will ask macOS to use this app for SSH links, .command/.tool files, and UNIX executables. macOS may show a confirmation prompt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux は、このアプリを SSH リンク、.command/.tool ファイル、UNIX 実行ファイルに使うよう macOS に要求します。macOS が確認を表示する場合があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux 将请求 macOS 用此应用处理 SSH 链接、.command/.tool 文件和 UNIX 可执行文件。macOS 可能会显示确认提示。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux wird macOS bitten, diese App für SSH-Links, .command/.tool-Dateien und UNIX-Ausführungsdateien zu verwenden. macOS zeigt möglicherweise eine Bestätigungsaufforderung an."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux demandera à macOS d’utiliser cette application pour les liens SSH, les fichiers .command/.tool et les exécutables UNIX. macOS peut afficher une invite de confirmation."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيطلب cmux من macOS استخدام هذا التطبيق لروابط SSH، وملفات .command/.tool، وملفات UNIX التنفيذية. قد يظهر macOS مطالبة تأكيد."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux solicitará a macOS usar esta aplicación para enlaces SSH, archivos .command/.tool y ejecutables de UNIX. Es posible que macOS muestre un aviso de confirmación."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
