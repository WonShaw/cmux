    "settings.automation.autoNamingAgent.status.failed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ couldn't generate a name — it may be rate-limited, out of tokens, or signed out. Existing names are left unchanged."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は名前を生成できませんでした。レート制限、トークン不足、またはサインアウトの可能性があります。既存の名前はそのまま保持されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法生成名称 — 可能是被限流、令牌用尽或已退出登录。现有名称保持不变。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ konnte keinen Namen generieren — eventuell gilt eine Ratenbegrenzung, es sind keine Token mehr vorhanden oder die Anmeldung fehlt. Bestehende Namen bleiben unverändert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'a pas pu générer de nom — il est peut-être limité par le débit, à court de jetons ou déconnecté. Les noms existants restent inchangés."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر على %@ توليد اسم — قد يكون مقيد المعدل، أو نفدت الرموز المميزة لديه، أو تم تسجيل الخروج. تظل الأسماء الحالية دون تغيير."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no pudo generar un nombre; puede tener el límite de frecuencia excedido, haberse quedado sin tokens o haber cerrado sesión. Los nombres existentes no se modificarán."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 無法產生名稱 —— 它可能受到速率限制、權杖用盡或已登出。現有名稱將保持不變。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 이름을 생성할 수 없습니다. 비율 제한이 초과되었거나, 토큰이 부족하거나, 로그아웃된 상태일 수 있습니다. 기존 이름은 변경되지 않은 상태로 유지됩니다."
          }
        }
      }
    },
