    "cli.help.notify.management" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The response includes the created notification id. Use cmux dismiss-notification --id <uuid>, cmux list-notifications, or cmux clear-notifications to manage notifications."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "応答には作成した通知の ID が含まれます。cmux dismiss-notification --id <uuid>、cmux list-notifications、または cmux clear-notifications で通知を管理できます。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتضمن الاستجابة معرّف الإشعار المنشأ. استخدم أوامر cmux لإدارة الإشعارات."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odgovor sadrži ID stvorene obavijesti. Koristite cmux naredbe za upravljanje obavijestima."
          }
        },
        "da" : {
