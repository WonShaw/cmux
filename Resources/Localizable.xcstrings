          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порожні вкладки браузера можуть показувати пропозицію імпорту. Сховайте або увімкніть її тут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空白浏览器标签页可以显示此导入建议。可在此处隐藏或重新启用。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leere Browser-Tabs können diesen Importvorschlag anzeigen. Blenden Sie ihn hier aus oder aktivieren Sie ihn wieder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les onglets vides du navigateur peuvent afficher cette suggestion d’importation. Masquez-la ou réactivez-la ici."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لعلامات تبويب المتصفح الفارغة إظهار اقتراح الاستيراد هذا. قم بإخفائه أو إعادة تمكينه هنا."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pestañas en blanco del navegador pueden mostrar esta sugerencia de importación. Ocúltela o vuelva a habilitarla aquí."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空白瀏覽器標籤頁可以顯示此匯入建議。在此處隱藏或重新啟用它。"
          }
        }
      }
    },
