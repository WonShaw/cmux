    "sudo.cli.queued" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sudo: request %@ queued; waiting up to %d seconds for approval in cmux…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sudo: リクエスト %1$@ をキューに追加しました。cmux での承認を最大 %2$d 秒待ちます…"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
