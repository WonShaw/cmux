    "dialog.simulatorCameraCleanupFailed.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux stayed open because it could not restore a Simulator app’s camera state. Quit again to retry cleanup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulator アプリのカメラ状態を復元できなかったため、cmux は終了しませんでした。もう一度終了してクリーンアップを再試行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux 仍保持打开，因为它无法恢复某个模拟器应用的相机状态。请再次退出以重试清理。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux blieb geöffnet, da der Kamerastatus einer Simulator-App nicht wiederhergestellt werden konnte. Erneut beenden, um die Bereinigung zu versuchen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux est resté ouvert car il n’a pas pu restaurer l’état de l’appareil photo d’une application Simulator. Quittez à nouveau pour réessayer le nettoyage."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ظل برنامج cmux مفتوحًا لأنه لم يتمكن من استعادة حالة الكاميرا لتطبيق Simulator. قم بالإنهاء مرة أخرى لإعادة محاولة التنظيف."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux permaneció abierto porque no pudo restaurar el estado de la cámara de una aplicación de Simulator. Sal de nuevo para volver a intentar la limpieza."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux 保持開啟狀態，因為無法還原 Simulator 應用程式的相機狀態。請再次結束以重試清理。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulator 앱의 카메라 상태를 복원할 수 없어 cmux가 열려 있습니다. 정리를 다시 시도하려면 다시 종료하세요."
          }
        }
      }
    },
