    "settings.browser.engine.subtitle.auto" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New browser panes use Chromium when your default browser is Chromium-based (Chrome, Edge, Brave, Arc…), otherwise WebKit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既定のブラウザが Chromium 系（Chrome、Edge、Brave、Arc など）の場合は新しいブラウザペインに Chromium を使用し、それ以外は WebKit を使用します。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Browser-Bereiche verwenden Chromium, wenn Ihr Standard-Browser auf Chromium basiert (Chrome, Edge, Brave, Arc…), andernfalls WebKit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouveaux volets de navigateur utilisent Chromium si votre navigateur par défaut est basé sur Chromium (Chrome, Edge, Brave, Arc…), sinon WebKit."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم أجزاء المتصفح الجديدة Chromium عندما يكون متصفحك الافتراضي قائمًا على Chromium (مثل Chrome أو Edge أو Brave أو Arc…)، وبخلاف ذلك WebKit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nuevos paneles del navegador usan Chromium cuando su navegador predeterminado está basado en Chromium (Chrome, Edge, Brave, Arc…), de lo contrario, usan WebKit."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當您的預設瀏覽器是基於 Chromium 的瀏覽器 (Chrome、Edge、Brave、Arc…) 時，新瀏覽器窗格會使用 Chromium，否則使用 WebKit。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当您的默认浏览器基于 Chromium（Chrome、Edge、Brave、Arc…）时，新浏览器窗格使用 Chromium，否则使用 WebKit。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 브라우저가 Chromium 기반(Chrome, Edge, Brave, Arc 등)인 경우 새 브라우저 패인에서 Chromium을 사용하고, 그렇지 않은 경우 WebKit을 사용합니다."
          }
        }
      }
    },
    "settings.browser.engine.subtitle.chromium" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a managed out-of-process Chromium runtime for new browser panes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいブラウザペインで管理対象の別プロセスChromiumランタイムを使用します。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie eine verwaltete Out-of-Process-Chromium-Runtime für neue Browser-Bereiche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser un runtime Chromium géré hors processus pour les nouveaux volets de navigateur."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم وقت تشغيل Chromium مدارًا خارج العملية لأجزاء المتصفح الجديدة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliza un entorno de ejecución de Chromium administrado fuera de proceso para los nuevos paneles del navegador."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "針對新瀏覽器窗格使用受管理的跨程序 Chromium 執行期環境。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对新浏览器窗格使用托管的进程外 Chromium 运行时。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 브라우저 패인에 관리형 별도 프로세스 Chromium 런타임을 사용합니다."
          }
        }
      }
    },
