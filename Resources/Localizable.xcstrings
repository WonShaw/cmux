    "debug.devWindowDisplay.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New DEBUG cmux windows open on the selected display. Shared across all tagged dev builds; applied at window creation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいDEBUG cmuxウィンドウは選択したディスプレイで開きます。すべてのタグ付き開発ビルドで共有され、ウィンドウ作成時に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 DEBUG cmux 창이 선택한 디스플레이에서 열립니다. 모든 태그가 지정된 개발 빌드에서 공유되며 창 생성 시 적용됩니다."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нові вікна DEBUG cmux відкриваються на вибраному дисплеї. Спільне для всіх позначених тегами складань розробки; застосовується під час створення вікна."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新的 DEBUG cmux 窗口会在所选显示器上打开。所有带标记的开发构建共用此设置；在创建窗口时生效。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue DEBUG-cmux-Fenster öffnen sich auf dem ausgewählten Bildschirm. Gemeinsam genutzt von allen getaggten Dev-Builds; wird bei der Fenstererstellung angewendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouvelles fenêtres cmux de DÉBOGAGE s'ouvrent sur l'écran sélectionné. Partagé entre tous les builds de développement étiquetés ; appliqué à la création de la fenêtre."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفتح نوافذ cmux لتصحيح الأخطاء (DEBUG) الجديدة على الشاشة المحددة. مشتركة عبر جميع بنيات التطوير المميزة بعلامات؛ وتُطبق عند إنشاء النافذة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las nuevas ventanas de depuración (DEBUG) de cmux se abren en la pantalla seleccionada. Compartido en todas las versiones de desarrollo etiquetadas; se aplica al crear la ventana."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新的偵錯 cmux 視窗將在選定的顯示器上開啟。此設定在所有標記的開發版本之間共用，並在建立視窗時套用。"
          }
        }
      }
    },
