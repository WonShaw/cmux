    "cli.vm.attach.cmuxTuiOnly" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ attaches only through its cmux-tui daemon. Run `cmux vm tui %1$@`; if that reports no client, install one with `curl -fsSL https://cmux.com/tui/install-static.sh | sh` or point CMUX_TUI_CLIENT at a binary."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は cmux-tui デーモン経由でのみ接続できます。`cmux vm tui %1$@` を実行してください。クライアントが見つからない場合は `curl -fsSL https://cmux.com/tui/install-static.sh | sh` でインストールするか、CMUX_TUI_CLIENT にバイナリを指定してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 只能通过其 cmux-tui 守护进程挂载。请运行 `cmux vm tui %1$@`；若提示没有客户端，用 `curl -fsSL https://cmux.com/tui/install-static.sh | sh` 安装一个，或把 CMUX_TUI_CLIENT 指向某个二进制文件。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ verbindet sich nur über seinen cmux-tui-Daemon. Führen Sie `cmux vm tui %1$@` aus; wenn dies meldet, dass kein Client vorhanden ist, installieren Sie einen mit `curl -fsSL https://cmux.com/tui/install-static.sh | sh` oder verweisen Sie mit CMUX_TUI_CLIENT auf eine Binärdatei."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ se connecte uniquement via son démon cmux-tui. Exécutez `cmux vm tui %1$@` ; si cela indique qu'aucun client n'est présent, installez-en un avec `curl -fsSL https://cmux.com/tui/install-static.sh | sh` ou faites pointer CMUX_TUI_CLIENT vers un binaire."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتصل %1$@ فقط من خلال خادم cmux-tui الخاص به. قم بتشغيل `cmux vm tui %1$@`؛ وإذا أبلغ ذلك عن عدم وجود عميل، فقم بتثبيت عميل باستخدام `curl -fsSL https://cmux.com/tui/install-static.sh | sh` أو قم بتوجيه CMUX_TUI_CLIENT إلى ملف ثنائي."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ se acopla solo a través de su demonio cmux-tui. Ejecuta `cmux vm tui %1$@`; si informa que no hay ningún cliente, instala uno con `curl -fsSL https://cmux.com/tui/install-static.sh | sh` o apunta CMUX_TUI_CLIENT a un binario."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 僅透過其 cmux-tui 常駐程式進行連接。執行 `cmux vm tui %1$@`；如果回報沒有用戶端，請使用 `curl -fsSL https://cmux.com/tui/install-static.sh | sh` 安裝一個，或將 CMUX_TUI_CLIENT 指向執行檔。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 은(는) cmux-tui 데몬을 통해서만 연결할 수 있습니다. `cmux vm tui %1$@`을(를) 실행하십시오. 클라이언트가 없다고 보고되는 경우, `curl -fsSL https://cmux.com/tui/install-static.sh | sh` 명령으로 설치하거나 CMUX_TUI_CLIENT 환경 변수가 바이너리를 가리키도록 설정하십시오."
          }
        }
      }
    },
