    "cli.vpn.appManaged.hostsHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Internal hostnames: run `cmux vpn hosts` to map <machine>.internal in /etc/hosts (needs sudo)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内部ホスト名: <machine>.internal を /etc/hosts に登録するには `cmux vpn hosts` を実行してください（sudo が必要）。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interne Hostnamen: Führen Sie `cmux vpn hosts` aus, um <machine>.internal in /etc/hosts zuzuordnen (erfordert sudo)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noms d'hôtes internes : exécutez `cmux vpn hosts` pour mapper <machine>.internal dans /etc/hosts (nécessite sudo)."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أسماء المضيفين الداخلية: قم بتشغيل `cmux vpn hosts` لتعيين <machine>.internal في ملف /etc/hosts (يتطلب sudo)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombres de host internos: ejecute `cmux vpn hosts` para mapear <machine>.internal en /etc/hosts (requiere sudo)."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "內部主機名稱：執行 `cmux vpn hosts` 以在 /etc/hosts 中對應 <machine>.internal (需要 sudo)。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内部主机名：运行 `cmux vpn hosts` 以在 /etc/hosts 中映射 <machine>.internal（需要 sudo）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내부 호스트 이름: `cmux vpn hosts`를 실행하여 /etc/hosts에 <machine>.internal을 매핑할 수 있습니다 (sudo 권한 필요)."
          }
        }
      }
    },
    "cli.vpn.status.autoManaged" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tunnel starts automatically when you open a Cloud machine and stops when no Cloud sessions remain."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トンネルはクラウドマシンを開くと自動的に開始し、クラウドセッションがなくなると停止します。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Tunnel startet automatisch, wenn Sie eine Cloud-Maschine öffnen, und stoppt, wenn keine Cloud-Sitzungen mehr verbleiben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tunnel démarre automatiquement lorsque vous ouvrez une machine Cloud et s'arrête lorsqu'il ne reste plus de sessions Cloud."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدأ النفق تلقائيًا عندما تفتح جهاز Cloud ويتوقف عندما لا تتبقى أي جلسات Cloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El túnel se inicia automáticamente al abrir una máquina de la nube y se detiene cuando no quedan sesiones en la nube."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通道會在您開啟雲端機器時自動啟動，並在沒有殘留任何雲端工作階段時停止。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该隧道会在您打开云机器时自动启动，并在没有云会话残留时停止。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud 머신을 열면 터널이 자동으로 시작되고, 남아 있는 Cloud 세션이 없을 때 중지됩니다."
          }
        }
      }
    },
    "cloudTree.link.tunnelOffAppManaged" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac's tunnel to your Cloud VM network is down; reopen the machine to start it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac からクラウド VM ネットワークへのトンネルは切断されています。マシンを再度開くと開始されます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Tunnel dieses Macs zu Ihrem Cloud-VM-Netzwerk ist ausgeschaltet; öffnen Sie die Maschine erneut, um ihn zu starten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tunnel de ce Mac vers votre réseau de VM Cloud est désactivé ; rouvrez la machine pour le démarrer."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نفق جهاز Mac هذا إلى شبكة أجهزة Cloud VM الخاصة بك متوقف؛ أعد فتح الجهاز لبدء تشغيله."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El túnel de esta Mac a su red de VM en la nube está desactivado; vuelva a abrir la máquina para iniciarlo."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這台 Mac 連往您的 Cloud VM 網路的通道已關閉；請重新開啟機器以啟動它。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Mac 到您的云 VM 网络的隧道已关闭；请重新打开机器以启动它。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서 Cloud VM 네트워크로의 터널이 연결 해제되었습니다. 시작하려면 머신을 다시 여세요."
          }
        }
      }
    },
