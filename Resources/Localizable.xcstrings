    "machines.meter.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Machines on your plan. Sleeping machines cost nothing."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プランのマシン数です。スリープ中のマシンは無料です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你套餐下的机器。休眠中的机器不产生费用。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maschinen in deinem Tarif. Ruhende Maschinen kosten nichts."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Machines incluses dans votre forfait. Les machines en veille ne coûtent rien."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأجهزة المشمولة في خطتك. الأجهزة الخاملة لا تكلف شيئًا."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máquinas de tu plan. Las máquinas inactivas no cuestan nada."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您方案中的機器。睡眠中的機器不收取任何費用。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요금제에 포함된 머신입니다. 절전 상태의 머신은 비용이 들지 않습니다."
          }
        }
      }
    },
