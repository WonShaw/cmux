    "agentRestore.admission.unavailable.hookStoreUnreadable" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux could not read its saved session records for this agent, so it cannot tell whether the session is already running. Retry 'cmux restore --surface'."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエージェントの保存済みセッション記録を読み取れなかったため、セッションがすでに実行中かどうかを cmux で判断できません。「cmux restore --surface」を再試行してください。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux konnte die gespeicherten Sitzungsdatensätze für diesen Agenten nicht lesen, sodass nicht festgestellt werden kann, ob die Sitzung bereits ausgeführt wird. Versuchen Sie es mit 'cmux restore --surface' erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux n'a pas pu lire ses enregistrements de session sauvegardés pour cet agent, il ne peut donc pas déterminer si la session est déjà en cours d'exécution. Réessayez 'cmux restore --surface'."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتمكن cmux من قراءة سجلات الجلسة المحفوظة لهذا الوكيل، لذا لا يمكنه معرفة ما إذا كانت الجلسة تعمل بالفعل أم لا. أعد المحاولة باستخدام 'cmux restore --surface'."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux no pudo leer sus registros de sesión guardados para este agente, por lo que no puede determinar si la sesión ya se está ejecutando. Vuelva a intentar 'cmux restore --surface'."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux 無法讀取此代理程式已儲存的工作階段記錄，因此無法判斷工作階段是否已在執行中。請重試 'cmux restore --surface'。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux 无法读取此代理已保存的会话记录，因此无法判断该会话是否已在运行。请重试 'cmux restore --surface'。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux가 이 에이전트에 대해 저장된 세션 기록을 읽을 수 없어 세션이 이미 실행 중인지 알 수 없습니다. 'cmux restore --surface'를 다시 시도하세요."
          }
        }
      }
    },
    "agentRestore.admission.unavailable.timedOut" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux could not finish checking whether this agent session is already running before the time limit. Retry 'cmux restore --surface'."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエージェントセッションがすでに実行中かどうかの確認が制限時間内に終わりませんでした。「cmux restore --surface」を再試行してください。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux konnte die Überprüfung, ob diese Agent-Sitzung bereits ausgeführt wird, nicht vor dem Zeitlimit abschließen. Versuchen Sie es mit 'cmux restore --surface' erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux n'a pas pu terminer la vérification si cette session d'agent est déjà en cours d'exécution avant la limite de temps. Réessayez 'cmux restore --surface'."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتمكن cmux من إنهاء التحقق مما إذا كانت جلسة الوكيل هذه تعمل بالفعل قبل انتهاء الحد الزمني. أعد المحاولة باستخدام 'cmux restore --surface'."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux no pudo terminar de verificar si esta sesión de agente ya se está ejecutando antes del límite de tiempo. Vuelva a intentar 'cmux restore --surface'."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux 無法在時限內完成檢查此代理程式工作階段是否已在執行中。請重試 'cmux restore --surface'。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux 未能在时间限制内完成检查此代理会话是否已在运行。请重试 'cmux restore --surface'。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux가 시간 제한 내에 이 에이전트 세션의 중복 실행 여부를 확인하지 못했습니다. 'cmux restore --surface'를 다시 시도하세요."
          }
        }
      }
    },
    "agentRestore.unverifiable.notice" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux could not verify whether this agent session is already running, so it did not resume the session automatically. Run 'cmux restore --surface' to resume it here."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエージェントセッションがすでに実行中かどうかを cmux で確認できなかったため、セッションを自動的に再開しませんでした。このターミナルで再開するには「cmux restore --surface」を実行してください。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux konnte nicht überprüfen, ob diese Agent-Sitzung bereits ausgeführt wird, daher wurde die Sitzung nicht automatisch fortgesetzt. Führen Sie 'cmux restore --surface' aus, um sie hier fortzusetzen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux n'a pas pu vérifier si cette session d'agent est déjà en cours d'exécution, elle n'a donc pas repris la session automatiquement. Exécutez 'cmux restore --surface' pour la reprendre ici."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتمكن cmux من التحقق مما إذا كانت جلسة الوكيل هذه تعمل بالفعل، لذلك لم يستأنف الجلسة تلقائيًا. قم بتشغيل 'cmux restore --surface' لاستئنافها هنا."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux no pudo verificar si esta sesión de agente ya se está ejecutando, por lo que no reanudó la sesión automáticamente. Ejecute 'cmux restore --surface' para reanudarla aquí."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux 無法驗證此代理程式工作階段是否已在執行中，因此未自動恢復工作階段。請執行 'cmux restore --surface' 以在此處恢復它。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux 无法验证此代理会话是否已在运行，因此未自动恢复该会话。请运行 'cmux restore --surface' 在此处恢复它。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux가 이 에이전트 세션의 중복 실행 여부를 확인할 수 없어 세션을 자동으로 재개하지 않았습니다. 여기서 재개하려면 'cmux restore --surface'를 실행하세요."
          }
        }
      }
    },
