    "settings.networking.neverUseRelays.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requires a reachable direct, local-network, or private-network path. Applies on the next reconnect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到達可能な直接経路、ローカルネットワーク経路、またはプライベートネットワーク経路が必要です。次回の再接続時に適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要有可达的直连、本地网络或私有网络路径。将在下次重连时生效。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfordert einen erreichbaren direkten Pfad, einen lokalen Netzwerkpfad oder einen privaten Netzwerkpfad. Wird beim nächsten Wiederverbinden angewendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessite un chemin direct, de réseau local ou de réseau privé accessible. S'applique lors de la prochaine reconnexion."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب مسارًا مباشرًا أو شبكة محلية أو شبكة خاصة يمكن الوصول إليه. يتم تطبيقه عند إعادة الاتصال التالية."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requiere una ruta accesible directa, de red local o de red privada. Se aplica en la siguiente reconexión."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要可連線的直接、本機網路或私人網路路徑。於下一次重新連線時套用。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도달 가능한 직접, 로컬 네트워크 또는 사설 네트워크 경로가 필요합니다. 다음 재연결 시 적용됩니다."
          }
        }
      }
    },
