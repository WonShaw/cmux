    "machines.freeAccess.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Free plans keep a machine reachable for %d day after it is created. Upgrade to Pro to keep using it."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Free plans keep a machine reachable for %d days after it is created. Upgrade to Pro to keep using it."
                }
              }
            }
          }
        },
        "ja" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "無料プランでは、マシンの作成後%d日間アクセス可能です。引き続き使用するにはProにアップグレードしてください。"
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "免费方案可在机器创建后的 %d 天内保持其可访问。升级到 Pro 以继续使用。"
                }
              }
            }
          }
        },
        "de" : {
          "variations" : {
