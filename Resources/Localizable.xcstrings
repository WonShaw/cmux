    "cli.automation.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usage: cmux automation <list|show|test|enable|disable|logs|reload> [args]\n\nRules live in ~/.cmuxterm/automations.json.\nExamples:\n  cmux automation list\n  cmux automation show surface-needs-input\n  cmux automation test surface-needs-input --event '{\"name\":\"agent.needs_input\"}'\n  cmux automation enable surface-needs-input\n  cmux automation disable surface-needs-input\n  cmux automation logs [--limit <n>]\n  cmux automation reload"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用法: cmux automation <list|show|test|enable|disable|logs|reload> [引数]\n\nルールは ~/.cmuxterm/automations.json に保存されます。\n例:\n  cmux automation list\n  cmux automation show surface-needs-input\n  cmux automation test surface-needs-input --event '{\"name\":\"agent.needs_input\"}'\n  cmux automation enable surface-needs-input\n  cmux automation disable surface-needs-input\n  cmux automation logs [--limit <n>]\n  cmux automation reload"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用法：cmux automation <list|show|test|enable|disable|logs|reload> [args]\n\n规则存放在 ~/.cmuxterm/automations.json。\n示例:\n  cmux automation list\n  cmux automation show surface-needs-input\n  cmux automation test surface-needs-input --event '{\"name\":\"agent.needs_input\"}'\n  cmux automation enable surface-needs-input\n  cmux automation disable surface-needs-input\n  cmux automation logs [--limit <n>]\n  cmux automation reload"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendung: cmux automation <list|show|test|enable|disable|logs|reload> [args]\n\nRegeln befinden sich in ~/.cmuxterm/automations.json.\nBeispiele:\n  cmux automation list\n  cmux automation show surface-needs-input\n  cmux automation test surface-needs-input --event '{\"name\":\"agent.needs_input\"}'\n  cmux automation enable surface-needs-input\n  cmux automation disable surface-needs-input\n  cmux automation logs [--limit <n>]\n  cmux automation reload"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usage : cmux automation <list|show|test|enable|disable|logs|reload> [args]\n\nLes règles se trouvent dans ~/.cmuxterm/automations.json.\nExemples :\n  cmux automation list\n  cmux automation show surface-needs-input\n  cmux automation test surface-needs-input --event '{\"name\":\"agent.needs_input\"}'\n  cmux automation enable surface-needs-input\n  cmux automation disable surface-needs-input\n  cmux automation logs [--limit <n>]\n  cmux automation reload"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاستخدام: cmux automation <list|show|test|enable|disable|logs|reload> [args]\n\nالقواعد موجودة في ~/.cmuxterm/automations.json.\nأمثلة:\n  cmux automation list\n  cmux automation show surface-needs-input\n  cmux automation test surface-needs-input --event '{\"name\":\"agent.needs_input\"}'\n  cmux automation enable surface-needs-input\n  cmux automation disable surface-needs-input\n  cmux automation logs [--limit <n>]\n  cmux automation reload"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uso: cmux automation <list|show|test|enable|disable|logs|reload> [args]\n\nLas reglas residen en ~/.cmuxterm/automations.json.\nEjemplos:\n  cmux automation list\n  cmux automation show surface-needs-input\n  cmux automation test surface-needs-input --event '{\"name\":\"agent.needs_input\"}'\n  cmux automation enable surface-needs-input\n  cmux automation disable surface-needs-input\n  cmux automation logs [--limit <n>]\n  cmux automation reload"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用法：cmux automation <list|show|test|enable|disable|logs|reload> [args]\n\n規則位於 ~/.cmuxterm/automations.json。\n範例：\n  cmux automation list\n  cmux automation show surface-needs-input\n  cmux automation test surface-needs-input --event '{\"name\":\"agent.needs_input\"}'\n  cmux automation enable surface-needs-input\n  cmux automation disable surface-needs-input\n  cmux automation logs [--limit <n>]\n  cmux automation reload"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용법: cmux automation <list|show|test|enable|disable|logs|reload> [args]\n\n규칙은 ~/.cmuxterm/automations.json에 저장됩니다.\n예시:\n  cmux automation list\n  cmux automation show surface-needs-input\n  cmux automation test surface-needs-input --event '{\"name\":\"agent.needs_input\"}'\n  cmux automation enable surface-needs-input\n  cmux automation disable surface-needs-input\n  cmux automation logs [--limit <n>]\n  cmux automation reload"
          }
        }
