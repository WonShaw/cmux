    "settings.app.imessageSortInsideGroups.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When iMessage mode floats unread workspaces to the top, sort members within each group while the group section stays put."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iMessage モードで未読ワークスペースを上に並べ替えるとき、グループのセクション位置は維持しつつ各グループ内のメンバーを並べ替えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当 iMessage 模式把未读工作区上浮到顶部时，在每个分组内部排序成员，分组区块位置保持不变。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn der iMessage-Modus ungelesene Arbeitsbereiche nach oben verschiebt, die Mitglieder innerhalb jeder Gruppe sortieren, während der Gruppenabschnitt an Ort und Stelle bleibt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque le mode iMessage fait remonter les espaces de travail non lus en haut, trier les membres au sein de chaque groupe tandis que la section du groupe reste immobile."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما يقوم وضع iMessage بتعويم مساحات العمل غير المقروءة إلى الأعلى، يتم فرز الأعضاء داخل كل مجموعة بينما يظل قسم المجموعة في مكانه."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando el modo iMessage hace flotar los espacios de trabajo no leídos al principio, ordena los miembros dentro de cada grupo mientras la sección del grupo permanece en su lugar."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當 iMessage 模式將未讀工作區置頂時，在群組區段位置保持不變的情況下排序各群組內的成員。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iMessage 모드에서 읽지 않은 작업 공간을 맨 위로 띄울 때, 그룹 섹션은 고정된 상태에서 각 그룹 내 멤버들을 정렬합니다."
