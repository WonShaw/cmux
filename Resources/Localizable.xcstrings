    "command.cloudVM.failed.action.launch" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reload cmux so its command-line tools are available, then retry. If it still fails, run the Cloud VM command in a terminal and send us the output."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コマンドラインツールを使えるように cmux を再読み込みしてから再試行してください。それでも失敗する場合は、ターミナルで Cloud VM コマンドを実行して出力を送ってください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请重新加载 cmux，使其命令行工具可用，然后重试。若仍然失败，请在终端中运行该 Cloud VM 命令，并把输出发给我们。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laden Sie cmux neu, damit seine Befehlszeilenwerkzeuge verfügbar sind, und versuchen Sie es erneut. Wenn es immer noch fehlschlägt, führen Sie den Cloud-VM-Befehl in einem Terminal aus und senden Sie uns die Ausgabe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechargez cmux pour que ses outils en ligne de commande soient disponibles, puis réessayez. Si cela échoue toujours, exécutez la commande Cloud VM dans un terminal et envoyez-nous la sortie."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعد تحميل cmux لتصبح أدوات سطر الأوامر الخاصة به متاحة، ثم أعد المحاولة. إذا استمر الفشل، فشغّل أمر Cloud VM في طرفية وأرسل إلينا المخرج."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a cargar cmux para que sus herramientas de línea de comandos estén disponibles, luego reintenta. Si sigue fallando, ejecuta el comando de la máquina virtual en la nube en una terminal y envíanos la salida."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請重新載入 cmux 以使其命令列工具可用，然後重試。如果仍然失敗，請在終端機中執行雲端虛擬機器 (Cloud VM) 指令，並將輸出傳送給我們。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux의 명령줄 도구를 사용할 수 있도록 cmux를 다시 로드한 후 다시 시도하세요. 계속 실패하는 경우 터미널에서 Cloud VM 명령을 실행하고 그 출력을 보내주세요."
          }
        }
      }
    },
    "command.cloudVM.failed.action.missingCLI" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install or reload a fresh cmux build, then retry. You can also run the Cloud VM command in a terminal to see the full error."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい cmux ビルドをインストールまたは再読み込みしてから再試行してください。ターミナルで Cloud VM コマンドを実行すると完全なエラーも確認できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请安装或重新加载新的 cmux 构建，然后重试。你也可以在终端中运行该 Cloud VM 命令以查看完整错误。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installieren oder laden Sie einen neuen cmux-Build neu und versuchen Sie es erneut. Sie können den Cloud-VM-Befehl auch in einem Terminal ausführen, um den vollständigen Fehler anzuzeigen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez ou rechargez une nouvelle version de cmux, puis réessayez. Vous pouvez également exécuter la commande Cloud VM dans un terminal pour voir l’erreur complète."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبّت نسخة بناء جديدة من cmux أو أعد تحميلها، ثم أعد المحاولة. يمكنك أيضًا تشغيل أمر Cloud VM في طرفية لعرض الخطأ بالكامل."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala o vuelve a cargar una versión reciente de cmux, luego reintenta. También puedes ejecutar el comando de la máquina virtual en la nube en una terminal para ver el error completo."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安裝或重新載入全新的 cmux 版本，然後重試。您也可以在終端機中執行 Cloud VM 命令以查看完整錯誤。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최신 cmux 빌드를 설치하거나 다시 로드한 후 다시 시도하세요. 터미널에서 Cloud VM 명령을 실행하여 전체 오류를 확인할 수도 있습니다."
          }
        }
      }
    },
