    "settings.notifications.agentPermissionPrompt.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notify when an agent is blocked waiting for your permission to run a tool."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントがツールの実行にあなたの許可を待って停止しているときに通知します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트가 도구 실행에 대한 사용자의 허가를 기다리며 멈췄을 때 알립니다."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сповіщати, коли агент заблоковано в очікуванні вашого дозволу на запуск інструмента."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
