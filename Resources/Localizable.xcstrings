    },
    "settings.sidebar.rightMaxWidth.subtitleOn" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن للـ Dock أن يتجاوز حد العرض المضمن مع الحفاظ على مساحة للطرفية."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock se može proširiti preko ugrađenog ograničenja širine uz očuvanje prostora za terminal."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Docken kan vokse forbi den indbyggede breddegrænse, mens der stadig reserveres plads til terminalen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Dock kann über die integrierte Breitenbegrenzung hinaus wachsen, während Platz für das Terminal erhalten bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Dock can grow past the built-in width cap while preserving terminal space."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Dock puede superar el límite de ancho integrado sin dejar de reservar espacio para la terminal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Dock peut dépasser la limite de largeur intégrée tout en réservant de l’espace au terminal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Dock può superare il limite di larghezza integrato mantenendo spazio per il terminale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock は端末用の空間を確保したまま、組み込みの幅上限を超えて広げられます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock អាចពង្រីកលើសដែនកំណត់ទទឹងដែលមានស្រាប់ ខណៈរក្សាកន្លែងសម្រាប់ terminal។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock은 터미널 공간을 유지하면서 내장 너비 상한을 넘어 커질 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Docken kan vokse forbi den innebygde breddegrensen samtidig som terminalplass beholdes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock może przekroczyć wbudowany limit szerokości, zachowując miejsce dla terminala."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Dock pode crescer além do limite de largura integrado enquanto preserva espaço para o terminal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock может превышать встроенное ограничение ширины, сохраняя место для терминала."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock สามารถขยายเกินขีดจำกัดความกว้างในตัว โดยยังคงเว้นพื้นที่ให้เทอร์มินัล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock, terminal alanını korurken yerleşik genişlik sınırını aşarak büyüyebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
