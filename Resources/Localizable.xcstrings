        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "fork: sačuvana sesija agenta nije dostupna. Terminal ostaje u svom sačuvanom direktorijumu; pokušajte kasnije ili započnite novu sesiju agenta."
