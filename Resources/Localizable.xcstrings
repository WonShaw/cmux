    "cloudTree.link.tunnelDown" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac's tunnel to your Cloud VM network is down — run `cmux vpn up`."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac から Cloud VM ネットワークへのトンネルが切断されています — `cmux vpn up` を実行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 通往 Cloud VM 网络的隧道已关闭 —— 请运行 `cmux vpn up`。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Tunnel dieses Macs zu Ihrem Cloud-VM-Netzwerk ist inaktiv — führen Sie `cmux vpn up` aus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tunnel de ce Mac vers le réseau de votre VM Cloud est arrêté — exécutez `cmux vpn up`."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نفق جهاز Mac هذا المؤدي إلى شبكة جهازك الافتراضي السحابي متوقف — شغّل `cmux vpn up`."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El túnel de este Mac a la red de tu máquina virtual en la nube está caído — ejecuta `cmux vpn up`."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這台 Mac 到您雲端虛擬機器 (Cloud VM) 網路的通道已中斷 — 請執行 `cmux vpn up`。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서 클라우드 가상 머신 네트워크로 연결되는 터널이 비활성화 상태입니다 — `cmux vpn up`을 실행하십시오."
          }
        }
      }
    },
    "cloudTree.link.tunnelStale" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
