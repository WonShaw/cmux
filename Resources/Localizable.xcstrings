    "settings.terminal.adaptiveDefaultTheme.subtitleOff" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An untouched Ghostty config uses Ghostty's fixed built-in palette. Existing Ghostty settings, including light/dark theme pairs, are always preserved."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghostty 設定が空の場合は、固定された組み込みパレットを使用します。ライト／ダークのテーマペアを含む既存の Ghostty 設定は常に保持します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未改动过的 Ghostty 配置会使用 Ghostty 固定的内置调色板。已有的 Ghostty 设置（包括浅色/深色主题配对）始终会被保留。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine unberührte Ghostty-Konfiguration verwendet die feste, integrierte Palette von Ghostty. Bestehende Ghostty-Einstellungen, einschließlich hell/dunkel-Theme-Paaren, bleiben immer erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une configuration Ghostty intacte utilise la palette fixe intégrée de Ghostty. Les paramètres Ghostty existants, y compris les paires de thèmes clair/sombre, sont toujours préservés."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم تكوين Ghostty غير المعدل لوحة الألوان المدمجة الثابتة لـ Ghostty. يتم دائمًا حفظ إعدادات Ghostty الحالية، بما في ذلك أزواج السمات الفاتحة والداكنة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una configuración de Ghostty intacta usa la paleta integrada fija de Ghostty. Los ajustes existentes de Ghostty, incluidos los pares de temas claro/oscuro, siempre se conservan."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未修改的 Ghostty 設定檔將使用 Ghostty 固定的內建調色盤。現有的 Ghostty 設定（包括淺色/深色主題配對）會始終保留。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수정되지 않은 Ghostty 설정은 Ghostty의 고정된 기본 팔레트를 사용합니다. 라이트/다크 테마 쌍을 포함한 기존 Ghostty 설정은 항상 유지됩니다."
          }
        }
      }
    },
    "settings.terminal.adaptiveDefaultTheme.subtitleOn" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use light and dark default terminal colors when no Ghostty theme or terminal colors are configured. Font and other settings are preserved."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghostty のテーマやターミナルの色が設定されていない場合、外観に合わせたライト／ダークの既定色を使用します。フォントなどの設定は保持されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未配置 Ghostty 主题或终端颜色时，使用随外观变化的浅色和深色默认终端配色。字体及其他设置会保留。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helle und dunkle Standardfarben für das Terminal verwenden, wenn kein Ghostty-Theme und keine Terminalfarben konfiguriert sind. Schrift- und andere Einstellungen bleiben erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise les couleurs claires et sombres par défaut du terminal si aucun thème Ghostty ni couleur de terminal n’est configuré. La police et les autres paramètres sont conservés."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم ألوان الطرفية الافتراضية الفاتحة والداكنة عندما لا يتم تكوين سمة Ghostty أو ألوان الطرفية. يتم الاحتفاظ بإعدادات الخط والإعدادات الأخرى."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa los colores claros y oscuros predeterminados del terminal cuando no hay ningún tema de Ghostty ni colores del terminal configurados. Se conservan la fuente y los demás ajustes."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未設定 Ghostty 主題或終端機顏色時，使用隨外觀變更的淺色和深色預設終端機配色。字體及其他設定會保留。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghostty 테마나 터미널 색상이 설정되지 않은 경우 모양에 따라 라이트 및 다크 기본 터미널 색상을 사용합니다. 글꼴 및 기타 설정은 유지됩니다."
          }
        }
      }
    },
    "settings.terminal.agentAutoResume" : {
      "extractionState" : "manual",
