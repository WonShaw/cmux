          "stringUnit" : {
            "state" : "translated",
            "value" : "Reloads the running app through Ghostty config update, matching startup theme resolution without editing config files."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定ファイルを編集せず、Ghostty 設定更新で実行中のアプリを再読み込みし、起動時のテーマ解決を再現します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 Ghostty 配置更新重新加载正在运行的应用，无需编辑配置文件即可与启动时的主题解析保持一致。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt die laufende App durch ein Ghostty-Konfigurationsupdate neu, was der Start-Theme-Auflösung entspricht, ohne Konfigurationsdateien zu bearbeiten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recharge l'application en cours d'exécution via la mise à jour de la configuration de Ghostty, en faisant correspondre la résolution du thème de démarrage sans modifier les fichiers de configuration."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيد تحميل التطبيق قيد التشغيل من خلال تحديث تكوين Ghostty، ليطابق دقة سمة بدء التشغيل دون تعديل ملفات التكوين."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a cargar la aplicación en ejecución mediante la actualización de la configuración de Ghostty, coincidiendo con la resolución del tema de inicio sin editar archivos de configuración."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過 Ghostty 設定更新重新載入執行中的應用程式，在不編輯設定檔的情況下，符合啟動時的佈景主題解析結果。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 파일을 직접 편집하지 않고 시작 테마 결정 방식과 일치하도록 Ghostty 설정 업데이트를 통해 실행 중인 앱을 다시 로드합니다."
          }
        }
      }
    },
