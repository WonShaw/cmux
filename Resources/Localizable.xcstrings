    "settings.workspaceColors.dictionaryNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edit cmux.json to add or remove named colors. \"Choose Custom Color...\" still adds local Custom N entries."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前付きカラーの追加や削除は cmux.json を編集してください。「カスタムカラーを選択…」は引き続きローカルの Custom N エントリを追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux.json을 편집하여 이름이 지정된 색상을 추가하거나 제거하세요. \"사용자 지정 색상 선택...\"으로 로컬 Custom N 항목을 추가할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "编辑 cmux.json 可添加或移除命名颜色。「选取自定义颜色...」仍会添加本地的「自定义 N」条目。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbeiten Sie cmux.json, um benannte Farben hinzuzufügen oder zu entfernen. \"Benutzerdefinierte Farbe wählen...\" fügt weiterhin lokale Einträge vom Typ \"Custom N\" hinzu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifiez cmux.json pour ajouter ou supprimer des couleurs nommées. \"Choisir une couleur personnalisée...\" ajoute toujours des entrées locales Custom N."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتحرير cmux.json لإضافة أو إزالة الألوان المسماة. لا يزال \"Choose Custom Color...\" يضيف إدخالات Custom N المحلية."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edita cmux.json para añadir o eliminar colores con nombre. \"Choose Custom Color...\" sigue añadiendo entradas locales de Custom N."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編輯 cmux.json 以新增或移除命名的顏色。「選擇自訂顏色...」仍會新增本機的「自訂 N」項目。"
          }
        }
      }
    },
    "settings.workspaceColors.emptyPalette" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No palette entries. Add colors in cmux.json or use \"Choose Custom Color...\" from a workspace context menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パレット項目はありません。cmux.json でカラーを追加するか、ワークスペースのコンテキストメニューから「カスタムカラーを選択…」を使ってください。"
