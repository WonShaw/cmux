    "settings.browser.remoteDebuggingPort.subtitleOff" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off by default. Chromium panes still use private CDP internally; no external endpoint is exposed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトはオフです。Chromiumペインは内部で非公開CDPを使用しますが、外部エンドポイントは公開されません。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig deaktiviert. Chromium-Bereiche verwenden intern weiterhin privates CDP; es wird kein externer Endpunkt freigegeben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé par défaut. Les volets Chromium utilisent toujours un CDP privé en interne ; aucun point de terminaison externe n'est exposé."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معطل افتراضيًا. لا تزال أجزاء Chromium تستخدم بروتوكول CDP الخاص داخليًا؛ لا يتم كشف أي نقطة نهاية خارجية."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado por defecto. Los paneles de Chromium siguen utilizando CDP privado internamente; no se expone ningún extremo externo."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設為關閉。Chromium 窗格內部仍使用私有 CDP；不公開外部端點。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认关闭。Chromium 窗格在内部仍使用私有 CDP；不公开任何外部端点。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본적으로 꺼져 있습니다. Chromium 패인은 여전히 내부적으로 비공개 CDP를 사용하며, 외부 엔드포인트는 노출되지 않습니다."
          }
        }
      }
    },
    "settings.browser.remoteDebuggingPort.subtitleOn" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New panes request http://127.0.0.1:%lld. If busy, cmux chooses another loopback port; CLI JSON reports the actual Playwright endpoint."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいペインではhttp://127.0.0.1:%lldを要求します。使用中の場合は別のループバックポートを使用し、CLIのJSONに実際のPlaywrightエンドポイントが表示されます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Bereiche fordern http://127.0.0.1:%lld an. Wenn dieser belegt ist, wählt cmux einen anderen Loopback-Port; der CLI-JSON-Bericht meldet den tatsächlichen Playwright-Endpunkt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouveaux volets demandent http://127.0.0.1:%lld. S'il est occupé, cmux choisit un autre port de bouclage (loopback) ; le JSON de la CLI indique le point de terminaison Playwright réel."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطلب الأجزاء الجديدة http://127.0.0.1:%lld. إذا كان مشغولاً، يختار cmux منفذ استرجاع آخر؛ يبلغ تنسيق JSON الخاص بـ CLI عن نقطة نهاية Playwright الفعلية."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nuevos paneles solicitan http://127.0.0.1:%lld. Si está ocupado, cmux elige otro puerto de bucle invertido; el JSON de la CLI informa el extremo real de Playwright."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新窗格會要求 http://127.0.0.1:%lld。若已被佔用，cmux 會選擇另一個回環 (loopback) 連接埠；CLI JSON 會回報實際的 Playwright 端點。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新窗格请求 http://127.0.0.1:%lld。如果该端口被占用，cmux 会选择另一个环回端口；CLI JSON 会报告实际的 Playwright 端点。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 패인은 http://127.0.0.1:%lld 포트를 요청합니다. 포트가 사용 중인 경우, cmux는 다른 루프백 포트를 대신 선택하며, CLI JSON은 실제 Playwright 엔드포인트를 보고합니다."
          }
        }
      }
    },
