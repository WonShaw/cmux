    "computerUse.onboarding.screenRecording.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Recording lets the Computer Use helper see app windows and screen content so it can act on what is visible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面収録を許可すると、Computer Useヘルパーはアプリウインドウや画面内容を確認し、表示されているものを操作できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屏幕录制让 Computer Use 助手能够看到应用窗口与屏幕内容，从而根据可见内容进行操作。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bildschirmaufnahme ermöglicht es dem Computer Use-Helfer, App-Fenster und Bildschirminhalte zu sehen, damit er auf das reagieren kann, was sichtbar ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement de l’écran permet à l’assistant Computer Use de voir les fenêtres des applications et le contenu de l’écran afin qu’il puisse agir sur ce qui est visible."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح تسجيل الشاشة لمساعد استخدام الكمبيوتر رؤية نوافذ التطبيق ومحتوى الشاشة حتى يتمكن من اتخاذ إجراء بناءً على ما هو مرئي."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación de pantalla permite que el asistente de Computer Use vea las ventanas de las aplicaciones y el contenido de la pantalla para poder actuar sobre lo que es visible."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「螢幕錄製」可讓電腦操作協助程式檢視應用程式視窗與螢幕內容，以便根據可見畫面進行操作。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 기록 권한을 허용하면 컴퓨터 사용 도우미가 앱 창 및 화면 콘텐츠를 볼 수 있어 화면에 표시되는 내용을 바탕으로 동작할 수 있습니다."
          }
        }
      }
    },
