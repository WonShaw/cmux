    "settings.app.fileEditorWordWrap.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wrap long lines at the editor's right edge instead of scrolling horizontally. Applies to the plain-text file editor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長い行を横スクロールせずにエディタの右端で折り返します。プレーンテキストのファイルエディタに適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长行在编辑器右边缘换行，而不是横向滚动。适用于纯文本文件编辑器。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lange Zeilen am rechten Rand des Editors umbrechen, anstatt horizontal zu scrollen. Gilt für den Nur-Text-Dateieditor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renvoyer les lignes longues à la ligne au bord droit de l’éditeur au lieu de faire défiler horizontalement. S’applique à l’éditeur de fichiers de texte brut."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التفاف السطور الطويلة عند الحافة اليمنى للمحرر بدلاً من التمرير أفقيًا. ينطبق على محرر الملفات النصية البسيطة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta las líneas largas en el borde derecho del editor en lugar de desplazarse horizontalmente. Se aplica al editor de archivos de texto sin formato."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在編輯器的右側邊緣將長行折行，而不是水平捲動。適用於純文字檔案編輯器。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가로로 스크롤하는 대신 편집기의 오른쪽 가장자리에서 긴 줄을 바꿉니다. 일반 텍스트 파일 편집기에 적용됩니다."
          }
        }
      }
    },
