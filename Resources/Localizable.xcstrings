    "cli.hooks.kiro.postInstallNote" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiro applies these hooks only when run as the cmux agent. Start Kiro with `kiro-cli chat --agent cmux`, or make it the default with `kiro-cli settings chat.defaultAgent cmux`."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiroフックはcmuxエージェントとして実行した場合のみ適用されます。Kiroを`kiro-cli chat --agent cmux`で起動するか、`kiro-cli settings chat.defaultAgent cmux`でデフォルトに設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiro 훅은 cmux 에이전트로 실행할 때만 적용됩니다. `kiro-cli chat --agent cmux`로 Kiro를 실행하거나 `kiro-cli settings chat.defaultAgent cmux`로 기본값으로 설정하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiro 仅在以 cmux agent 身份运行时应用这些 hooks。请用 `kiro-cli chat --agent cmux` 启动 Kiro，或用 `kiro-cli settings chat.defaultAgent cmux` 将其设为默认。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiro wendet diese Hooks nur an, wenn es als cmux-Agent ausgeführt wird. Starten Sie Kiro mit `kiro-cli chat --agent cmux` oder machen Sie es mit `kiro-cli settings chat.defaultAgent cmux` zum Standard."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiro applique ces hooks uniquement lorsqu'il est exécuté en tant qu'agent cmux. Démarrez Kiro avec `kiro-cli chat --agent cmux` ou définissez-le par défaut avec `kiro-cli settings chat.defaultAgent cmux`."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطبق Kiro هذه الخطافات فقط عند تشغيله كوكيل لـ cmux. ابدأ Kiro باستخدام `kiro-cli chat --agent cmux`، أو اجعله الافتراضي باستخدام `kiro-cli settings chat.defaultAgent cmux`."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiro aplica estos hooks solo cuando se ejecuta como el agente de cmux. Inicie Kiro con `kiro-cli chat --agent cmux`, o conviértalo en el valor predeterminado con `kiro-cli settings chat.defaultAgent cmux`."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiro 僅在作為 cmux 代理程式執行時才套用這些勾點。請使用 `kiro-cli chat --agent cmux` 啟動 Kiro，或使用 `kiro-cli settings chat.defaultAgent cmux` 將其設為預設值。"
          }
        }
      }
    },
