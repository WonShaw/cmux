    "settings.networking.relayOnly.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps Iroh connections to this Mac on cmux relays instead of direct or local-network paths. Applies on the next reconnect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac への Iroh 接続を、直接経路やローカルネットワーク経路ではなく cmux リレー経由に固定します。次回の再接続時に適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让到此 Mac 的 Iroh 连接走 cmux 中继，而不是直连或局域网路径。在下次重连时生效。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält Iroh-Verbindungen zu diesem Mac auf cmux-Relays anstatt auf direkten oder lokalen Netzwerkpfaden. Wird beim nächsten Wiederverbinden angewendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintient les connexions Iroh à ce Mac sur les relais cmux au lieu de chemins directs ou de réseau local. S'applique lors de la prochaine reconnexion."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقي اتصالات Iroh بجهاز Mac هذا على مرحلات cmux بدلاً من المسارات المباشرة أو شبكة الاتصال المحلية. يتم تطبيقه عند إعادة الاتصال التالية."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene las conexiones de Iroh a esta Mac en retransmisiones de cmux en lugar de rutas directas o de red local. Se aplica en la siguiente reconexión."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將連線至此 Mac 的 Iroh 連線保持在 cmux 中繼上，而非使用直接或本機網路路徑。於下一次重新連線時套用。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에 대한 Iroh 연결을 직접 또는 로컬 네트워크 경로 대신 cmux 릴레이로 유지합니다. 다음 재연결 시 적용됩니다."
          }
        }
      }
    },
    "settings.notifications.agentIdleReminder.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notify when an agent has been idle waiting for your input. Suppressed while background work is still running."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントがあなたの入力を待って待機しているときに通知します。バックグラウンド作業の実行中は抑制されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트가 사용자의 입력을 기다리며 유휴 상태일 때 알립니다. 백그라운드 작업이 실행 중일 때는 억제됩니다."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сповіщати, коли агент неактивний і очікує вашого вводу. Придушується, доки виконується фонова робота."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当代理空闲等待你输入时通知。后台工作仍在运行时不通知。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benachrichtigen, wenn ein Agent im Leerlauf ist und auf Ihre Eingabe wartet. Unterdrückt, während noch Hintergrundarbeit läuft."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifier lorsqu'un agent est resté inactif en attente de votre saisie. Désactivé tant que le travail en arrière-plan est toujours en cours d'exécution."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إعلامي عندما يكون الوكيل خاملاً في انتظار إدخالك. يتم كتمه أثناء استمرار تشغيل العمل في الخلفية."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notificar cuando un agente haya estado inactivo esperando tu respuesta. Se silencia mientras el trabajo en segundo plano sigue ejecutándose."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當代理程式因等待您的輸入而閒置時發出通知。若背景工作仍在執行中，則會隱藏此通知。"
          }
        }
      }
    },
