    "cli.vpn.switching" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tunnel that is up was brought up for another enrollment (a different account, or older keys). Replacing it with this one (sudo will prompt for your password)…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続中のトンネルは別の登録（別のアカウント、または古い鍵）で立ち上げられたものです。このトンネルに置き換えます（sudo がパスワードを求めます）…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前开启的隧道属于另一次注册（不同账户，或更早的密钥）。正在用这一次替换它（sudo 会提示输入密码）…"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der aktive Tunnel wurde für eine andere Registrierung aufgebaut (ein anderes Konto oder ältere Schlüssel). Er wird durch diesen ersetzt (sudo fragt nach Ihrem Passwort)…"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tunnel actif a été établi pour une autre inscription (un autre compte ou des clés plus anciennes). Remplacement par celui-ci (sudo vous demandera votre mot de passe)…"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النفق الذي يعمل حاليًا تم تشغيله لتسجيل آخر (حساب مختلف، أو مفاتيح أقدم). يتم استبداله بهذا النفق (سيتطلب sudo إدخال كلمة المرور الخاصة بك)…"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El túnel que está activo se habilitó para otro registro (una cuenta diferente o claves más antiguas). Reemplazándolo por este (sudo te solicitará tu contraseña)…"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前啟動的通道是為另一個註冊 (不同的帳戶或較舊的金鑰) 所建立。正在以當前通道取代它 (將會提示輸入 sudo 密碼)…"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 활성화된 터널은 다른 등록 정보(다른 계정 또는 이전 키)를 위해 활성화된 상태입니다. 이 터널로 대체하는 중입니다 (sudo 실행을 위해 비밀번호 입력 프롬프트가 표시됩니다)…"
          }
        }
      }
    },
    "cli.vpn.switchFailed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not switch the tunnel. Check the command output above, run `cmux vpn down`, then retry `cmux vpn up`."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トンネルを切り替えられませんでした。上のコマンド出力を確認し、`cmux vpn down` を実行してから `cmux vpn up` を再試行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法切换隧道。请查看上方的命令输出，运行 `cmux vpn down`，然后重试 `cmux vpn up`。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunnel konnte nicht gewechselt werden. Überprüfen Sie die obige Befehlsausgabe, führen Sie `cmux vpn down` aus und versuchen Sie es dann erneut mit `cmux vpn up`."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de changer de tunnel. Vérifiez la sortie de la commande ci-dessus, exécutez `cmux vpn down`, puis réessayez `cmux vpn up`."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر تبديل النفق. تحقق من مخرجات الأمر أعلاه، ثم شغّل `cmux vpn down` وأعد المحاولة عبر `cmux vpn up`."
          }
        },
        "es" : {
