    "featureFlags.footer.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remote values take priority, except for local Cloud overrides in Nightly and debug builds."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモート値が優先されます。ただし、NIGHTLYとデバッグビルドのCloudのローカル上書きは例外です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "远程值优先，但 Nightly 和调试版本中的 Cloud 本地覆盖除外。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remote-Werte haben Vorrang, außer bei lokalen Cloud-Überschreibungen in Nightly- und Debug-Builds."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les valeurs distantes ont la priorité, sauf les surcharges locales de Cloud dans les versions Nightly et de débogage."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تكون الأولوية للقيم البعيدة، باستثناء تجاوزات Cloud المحلية في إصدارات Nightly وتصحيح الأخطاء."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores remotos tienen prioridad, salvo las anulaciones locales de Cloud en las versiones Nightly y de depuración."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遠端值優先，但 Nightly 和除錯版本中的 Cloud 本機覆寫除外。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원격 값이 우선하지만 Nightly 및 디버그 빌드의 로컬 Cloud 재정의는 예외입니다."
          }
        }
      }
    },
    "featureFlags.mobileTaskComposer.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enables the iOS New Task composer, including task model discovery, directory picking, and attachment staging."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSの新規タスク作成を有効にします。タスクモデル検出、ディレクトリ選択、添付ファイルのステージングを含みます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用 iOS 的「新建任务」编辑器，包括任务模型发现、目录选择与附件暂存。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviert den iOS-Composer für neue Aufgaben, einschließlich der Erkennung von Aufgabenmodellen, Verzeichnisauswahl und Bereitstellung von Anhängen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active le compositeur de nouvelles tâches iOS, y compris la découverte de modèles de tâches, la sélection de répertoires et la mise en attente (staging) des pièces jointes."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكّن منشئ المهام الجديدة لنظام iOS، بما في ذلك اكتشاف نموذج المهمة، واختيار الدليل، وتجهيز المرفقات."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habilita el creador de nuevas tareas de iOS, incluido el descubrimiento de modelos de tareas, la selección de directorios y la preparación de archivos adjuntos."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用 iOS 新增任務編輯器，包含任務模型探索、目錄選取及附件暫存。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업 모델 탐색, 디렉터리 선택 및 첨부 파일 준비를 포함한 iOS 새 작업 작성기를 활성화합니다."
          }
        }
      }
    },
