        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux.json에서 tmux 스타일의 다단계 단축키를 추가할 수 있습니다. 예: [\"ctrl+b\", \"c\"]."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
