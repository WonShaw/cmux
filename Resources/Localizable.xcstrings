          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التحقق من المرحل فقط"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificación de solo retransmisión"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅限中繼驗證"
          }
        },
        "ko" : {
